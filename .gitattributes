# Let Git normalize text files (store LF in the repository).
* text=auto

# Files that are executed or consumed on Linux build catlets / VMs must keep
# LF endings even when the repo is checked out on Windows. Git's autocrlf
# would otherwise hand them CRLF, which makes bash fail with a fast "exit 2"
# before any logging starts, and breaks cloud-init / systemd units the same way.
*.sh      text eol=lf
*.cfg     text eol=lf
*.conf    text eol=lf
*.service text eol=lf
